{
  "name": "giens-ch",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "build": "nuxt build && node scripts/prepare-functions.mjs && node scripts/report-client-bundle.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:prod": "NITRO_PRESET=node-server nuxt preview --host 127.0.0.1 --port 3000",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "deploy": "npm run build && firebase deploy --project giens-ch --only firestore,functions,hosting",
    "deploy:full": "npm run build && firebase deploy --project giens-ch",
    "start": "nuxt preview",
    "test": "vitest",
    "test:fast": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:translations": "node scripts/check-translations.mjs",
    "test:e2e": "PLAYWRIGHT_SMOKE=1 playwright test tests/e2e/critical-flows.spec.ts tests/e2e/console-errors-public.test.ts tests/e2e/console-errors-critical-flows.test.ts tests/e2e/resource-errors-all-routes.test.ts --project=chromium",
    "test:e2e:smoke": "PLAYWRIGHT_SMOKE=1 playwright test tests/e2e/critical-flows.spec.ts tests/e2e/console-errors-public.test.ts tests/e2e/console-errors-critical-flows.test.ts tests/e2e/resource-errors-all-routes.test.ts --project=chromium",
    "test:e2e:full": "playwright test",
    "test:perf": "NITRO_PRESET=node-server npm run build && PLAYWRIGHT_PREVIEW=1 playwright test tests/e2e/performance-audit.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-drag-handle": "^3.30.3",
    "@tiptap/extension-highlight": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extensions": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/vue-3": "^3.30.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "nuxt": "^4.5.2",
    "punycode": "^2.3.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "punycode": "^2.3.1",
    "tr46": "^5.0.0",
    "whatwg-url": "^14.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "playwright-core": "^1.62.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
