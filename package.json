{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/prepare-functions.mjs && node scripts/report-client-bundle.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && firebase deploy",
    "start": "nuxt preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "playwright test tests/e2e/performance-audit.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0-alpha.9",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@tiptap/core": "^3.0.7",
    "@tiptap/extension-drag-handle": "^3.0.7",
    "@tiptap/extension-highlight": "^3.0.7",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/extension-task-item": "^3.0.7",
    "@tiptap/extension-task-list": "^3.0.7",
    "@tiptap/extension-text-align": "^3.0.7",
    "@tiptap/extensions": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@tiptap/vue-3": "^3.0.7",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.4",
    "nuxt": "^4.3.0",
    "punycode": "^2.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "overrides": {
    "punycode": "^2.3.1",
    "tr46": "^5.0.0",
    "whatwg-url": "^14.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@nuxt/test-utils-nightly": "3.23.1-20260126-202417-426e0b5",
    "@playwright/test": "^1.58.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.3.7",
    "playwright-core": "^1.58.0",
    "vitest": "^4.0.18"
  }
