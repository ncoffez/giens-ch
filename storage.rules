rules_version = '2';

// Uploads go through Nitro + the Admin SDK, which bypasses these rules.
// Profile pictures are referenced as public media URLs (no download token).
service firebase.storage {
	match /b/{bucket}/o {
		match /profile-pictures/{uid} {
			allow read: if true;
			allow write: if false;
		}
		match /profile-pictures/{uid}/history/{allPaths=**} {
			allow read: if true;
			allow write: if false;
		}

		match /{allPaths=**} {
			allow read, write: if false;
		}
	}
}
