{
  "functions": [
    {
      "source": ".output/server",
      "predeploy": [
        "npm run build"
      ],
      "ignore": [
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": ".output/public",
    "predeploy": [
      "npm run build"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "**",
        "function": "server"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}