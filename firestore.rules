rules_version = '2';

// Client SDK access is denied. The app reads and writes Firestore through
// Nitro (`server/api/**`) with the Admin SDK, which bypasses these rules.
// Never open this to unauthenticated or blanket client access.
service cloud.firestore {
	match /databases/{database}/documents {
		match /{document=**} {
			allow read, write: if false;
		}
	}
}
