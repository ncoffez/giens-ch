ALLOWED_EVENT_TYPES=firebase.extensions.firestore-translate-text.v1.onSuccess
COLLECTION_PATH=content
EVENTARC_CHANNEL=projects/${param:PROJECT_ID}/locations/europe-west4/channels/firebase
firebaseextensions.v1beta.function/ingressSettings=ALLOW_ALL
firebaseextensions.v1beta.function/location=europe-west6
firebaseextensions.v1beta.function/maxInstances=5
firebaseextensions.v1beta.function/memory=128
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/timeoutSeconds=30
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
GEMINI_MODEL=gemini-2.5-flash
INPUT_FIELD_NAME=content
LANGUAGES=fr
OUTPUT_FIELD_NAME=content_fr
TRANSLATION_PROVIDER=gemini-vertexai