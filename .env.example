# Copy to .env and fill in. .env is gitignored and is NOT recoverable from a
# fresh clone — keep a copy somewhere safe (password manager).
# Every variable below is read by nuxt.config.ts and baked into the build at
# BUILD time, so rebuild after changing anything here.

# --- Firebase (required) ---
# Web app config from Firebase console. Single-line JSON, unquoted.
FIREBASE_FRONTEND_KEY={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}
# Service account JSON, single line. Keep the .json file in .secrets/ (gitignored).
FIREBASE_ADMIN_KEY=
# Defaults to <project_id>.appspot.com if unset.
STORAGE_BUCKET=

# --- Site (required for correct canonical tags and share links) ---
# Baked into the build. Must be the PRODUCTION url, never localhost.
SITE_URL=https://giens.ch

# --- Unsplash image picker (server/api/unsplash.get.ts) ---
# JSON — only accessKey is read. Feature 500s if unset.
UNSPLASH_API_KEY={"accessKey":""}

# --- Error reports -> GitHub issues (server/utils/githubIssues.ts) ---
# Fine-grained PAT, this repo only, permission "Issues: Read and write".
# Never a classic token with `repo` scope — that is too broad if the
# repository is public. Issues stop being filed (503) if unset.
GITHUB_ISSUES_TOKEN=
# Must be set explicitly (CI uses github.repository). No hardcoded default.
GITHUB_REPO=ncoffez/giens-ch

# --- Document translation (Gemini) ---
# Raw key string, not JSON.
GEMINI_API_KEY=
# Optional, defaults below.
GEMINI_MODEL=gemini-2.5-flash
DOCUMENT_TRANSLATION_LANGUAGES=fr
